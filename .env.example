# Serendipity Web UI environment configuration.
# Copy this file to .env and adjust the values for your setup.

# Address and port the web UI server binds to. Defaults bind to loopback only
# (127.0.0.1:8080); set SERENDIPITY_WEBUI_HOST=0.0.0.0 to expose the UI on all
# interfaces (use with caution, the /api/tts-proxy endpoint is an outbound
# HTTP relay).
# SERENDIPITY_WEBUI_HOST=127.0.0.1
# SERENDIPITY_WEBUI_PORT=8080

# Comma-separated allowlist of TTS proxy host names.
# Allowlisted hosts bypass DNS resolution and all private/loopback/link-local
# IP checks, so only add trusted hosts. Example:
# SERENDIPITY_TTS_ALLOWED_HOSTS=tts.example.com,192.168.0.202
SERENDIPITY_TTS_ALLOWED_HOSTS=

# Opt-in to permit TTS proxying to ANY public host when
# SERENDIPITY_TTS_ALLOWED_HOSTS is unset. With the allowlist unset the proxy is
# DISABLED by default unless this flag is set to a truthy value (1/true/yes/on).
# SERENDIPITY_TTS_ALLOW_ANY_PUBLIC_HOST=1

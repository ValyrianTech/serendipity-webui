# Serendipity Web UI environment configuration.
# Copy this file to .env and adjust the values for your setup.

# Comma-separated allowlist of TTS proxy host names.
# Allowlisted hosts bypass DNS resolution and all private/loopback/link-local
# IP checks, so only add trusted hosts. Leave unset to allow only public hosts.
# Example:
# SERENDIPITY_TTS_ALLOWED_HOSTS=tts.example.com,192.168.0.202
SERENDIPITY_TTS_ALLOWED_HOSTS=

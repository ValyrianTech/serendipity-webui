# Serendipity Web UI environment configuration.
# Copy this file to .env and adjust the values for your setup.

# Address and port the web UI server binds to. Defaults bind to loopback only
# (127.0.0.1:8080); set SERENDIPITY_WEBUI_HOST=0.0.0.0 to expose the UI on all
# interfaces (use with caution, the /api/tts-proxy endpoint forwards requests
# to the TTS servers configured below).
# SERENDIPITY_WEBUI_HOST=127.0.0.1
# SERENDIPITY_WEBUI_PORT=8080

# Trusted TTS servers, as a JSON object mapping an opaque selector key to the
# server's base URL. The /api/tts-proxy endpoint resolves the client-supplied
# selector against this map; the outbound URL is never taken from the request,
# so the endpoint cannot be used to fetch an arbitrary address (SSRF). The
# default selector is "primary". Example:
# SERENDIPITY_TTS_SERVERS={"primary": "http://192.168.0.202:7860"}
SERENDIPITY_TTS_SERVERS=
